{
  "name": "keynest-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch server/index.js",
    "setup": "node scripts/setup-env.js",
    "check:config": "node scripts/check-config.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "worker:payments": "node server/payment-worker.js",
    "infra:topics": "node scripts/kafka-topics.js",
    "infra:status": "node scripts/kafka-status.js",
    "test:infra": "node scripts/test-infrastructure.js",
    "test": "node --test tests/*.test.js",
    "seed": "node scripts/seed.js",
    "test:db": "node scripts/test-db.js",
    "test:ui": "playwright test",
    "format": "prettier --write src server shared scripts tests *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.468.0",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
