# Copy to .env. Never use VITE_ for secrets.
APP_MODE=demo
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# APP_MODE=supabase requires all values below, plus the SQL migration and seed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after configuring each provider in Supabase Authentication.
AUTH_GOOGLE_ENABLED=false
AUTH_DISCORD_ENABLED=false
# Google reCAPTCHA v2 Checkbox. See docs/RECAPTCHA.md. Secret stays on backend.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_ENCRYPTION_KEY=
# Tingee static QR supports personal VCB accounts; Pay2S is the automatic fallback.
BANK_PAYMENT_PROVIDER=tingee
TINGEE_QR_MODE=static
TINGEE_CLIENT_ID=
TINGEE_SECRET_TOKEN=
TINGEE_BANK_BIN=
# VCB account linked through Tingee; VCB personal transfers must go to this VA.
TINGEE_VA_ACCOUNT=
TINGEE_ACCOUNT_NAME=
# Only Master Merchant credentials require this numeric ID.
TINGEE_MERCHANT_ID=
TINGEE_BASE_URL=https://open-api.tingee.vn
# Pay2S fallback receiving bank (may differ from the Tingee VA).
BANK_CODE=MB
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# Token shown once when creating the Pay2S webhook. Paste the token only, without Bearer.
PAY2S_WEBHOOK_TOKEN=
# Legacy SePay configuration, used when generic BANK_* fields are empty.
SEPAY_WEBHOOK_KEY=
SEPAY_BANK=VCB
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Set only when behind exactly this many trusted reverse proxies.
TRUST_PROXY=0

# Optional distributed infrastructure. Keep false for local demo mode.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_PAYMENT_TOPIC=keynest.payments.v1
KAFKA_PAYMENT_GROUP=keynest-settlement-v1
KAFKA_CLIENT_ID=keynest
KAFKA_WORKER_CONCURRENCY=4
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-512
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=keynest:
# Topic creation defaults are for the single-node local compose only.
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_MIN_ISR=1

# Public footer links. Restart Vite after changing these values.
VITE_DISCORD_URL=
VITE_FACEBOOK_URL=

# Admin email OTP is mandatory in Supabase mode; configure SMTP before deployment.

# Order receipts use Brevo's API key (not the SMTP key configured in Supabase).
ORDER_RECEIPTS_ENABLED=false
BREVO_API_KEY=
ORDER_RECEIPTS_FROM=

